/*
 * ArtPad: 11 buttons + 3 clickable encoders on a nice!nano v2 (or clone).
 *
 * Pin budget (16 usable Pro Micro pins, NFC pins 10/16 kept spare):
 *   Rows 0-3      : pro_micro 0, 1, 4, 5     (left edge)
 *   Cols 0-3      : pro_micro 6, 7, 8, 9     (left edge)
 *   I2C (haptics) : pro_micro 2 = SDA, 3 = SCL  -- reserved, not used yet.
 *                   These are the board's default i2c0 pins (pro_micro_i2c).
 *   Encoders      : pro_micro 21/20 knob, 19/18 dial, 15/14 scroll (right edge)
 *
 * Matrix wiring (col2row): column pin -> switch -> diode -> row pin.
 * Diode black band (cathode) faces the ROW.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "artpad-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        // col2row: ZMK drives one column high at a time and reads the rows.
        // Rows get pull-downs so they read 0 unless a pressed switch connects
        // them to the active column.
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&pro_micro 6 GPIO_ACTIVE_HIGH>   // col 0  P1.00
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>   // col 1  P0.11
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>   // col 2  P1.04
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>   // col 3  P1.06
            ;

        row-gpios
            = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 0  P0.08
            , <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 1  P0.06
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 2  P0.22
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // row 3  P0.24
            ;
    };

    // Maps physical matrix positions (row, col) to keymap positions, in order.
    // The 2 spare slots RC(2,3) and RC(3,3) are left out. To use one later,
    // add it here AND add a binding in every keymap layer at the same spot.
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <4>;
        rows = <4>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)   // D-pad: up, down, left, right
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)   // B1 B2 B3 B4
            RC(2,0) RC(2,1) RC(2,2)           // B5 B6 B7
            RC(3,0) RC(3,1) RC(3,2)           // knob click, dial click, scroll click
        >;
    };

    // Encoders: A/B are quadrature signals, read on interrupts (not scanned).
    // The common pin (C on a bare EC11, GND on a KY-040) goes to GND, so the
    // pins idle high via pull-up and are pulled low as the contacts close.
    // steps = 80: a typical EC11 has 20 detents x 4 signal edges per detent.
    knob: knob {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P0.31
        b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P0.29
        steps = <80>;
        status = "okay";
    };

    dial: dial {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P0.02
        b-gpios = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P1.15
        steps = <80>;
        status = "okay";
    };

    scroll: scroll {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P1.13
        b-gpios = <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  // P1.11
        steps = <80>;
        status = "okay";
    };

    // Tells the keymap which sensors exist; sensor-bindings in the keymap are
    // matched to these in the same order (knob, dial, scroll).
    // triggers-per-rotation = 20: one key press per detent click.
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&knob &dial &scroll>;
        triggers-per-rotation = <20>;
    };
};
